# za pokretanje backend-a van dockera (baze podignute sa docker-compose.dev.yml)
# kopiraj u apps/backend/.env.local; vidi README, odeljak "Razvoj"
NODE_ENV=development
PORT=3000

REDIS_URL=redis://localhost:6379

CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_DC=datacenter1
CASSANDRA_KEYSPACE=pixelboard

CANVAS_WIDTH=300
CANVAS_HEIGHT=300
COOLDOWN_MS=5000
SESSION_TTL_DAYS=7
COOKIE_SECURE=false

PERSISTER_BATCH_SIZE=500
PERSISTER_BLOCK_MS=2000
PERSISTER_CLAIM_IDLE_MS=30000

SNAPSHOT_MIN_MOVES=10000
SNAPSHOT_INTERVAL_MS=300000
SNAPSHOT_KEEP=12

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
