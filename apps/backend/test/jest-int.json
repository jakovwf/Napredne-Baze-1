{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".int-spec.ts$",
  "setupFiles": ["<rootDir>/setup-int-env.ts"],
  "globalSetup": "<rootDir>/global-setup-int.ts",
  "testTimeout": 60000,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
