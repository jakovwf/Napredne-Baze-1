# kopiraj u .env:  cp .env.example .env   (.env nikad ne ide u git)

# development | production; u production-u backend odbija ADMIN_PASSWORD=change-me
NODE_ENV=development

# api | worker; u docker-compose.yml se postavlja po servisu, za rad bez dockera zadaj ručno
APP_ROLE=api
PORT=3000

REDIS_URL=redis://redis:6379

CASSANDRA_CONTACT_POINTS=cassandra
CASSANDRA_DC=datacenter1
CASSANDRA_KEYSPACE=pixelboard

# dimenzije platna se zadaju pre prvog pokretanja; promena kasnije traži reset baza
CANVAS_WIDTH=300
CANVAS_HEIGHT=300
COOLDOWN_MS=5000
SESSION_TTL_DAYS=7

# kolačić sid dobija atribut Secure; na serveru sa https-om postaviti na true
# (preko http-a browser ne šalje Secure kolačić, pa prijava ne bi radila)
COOKIE_SECURE=false

# persister (worker): veličina batch-a, trajanje XREADGROUP BLOCK i posle koliko ms mirovanja
# se pending poruke mrtvog consumer-a preuzimaju (XAUTOCLAIM)
PERSISTER_BATCH_SIZE=500
PERSISTER_BLOCK_MS=2000
PERSISTER_CLAIM_IDLE_MS=30000

# snapshot platna (worker): posle koliko poteza ili koliko ms (ako ima izmena)
# i koliko poslednjih snapshot-ova se čuva
SNAPSHOT_MIN_MOVES=10000
SNAPSHOT_INTERVAL_MS=300000
SNAPSHOT_KEEP=12

# prvi admin, upisuje se pri startu api-ja; promeni lozinku
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
